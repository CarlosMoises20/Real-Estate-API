
# Ignore all subdirectories inside "datasets" by default
backend/datasets/*/

# Ignore datasets generated by the data preparation pipeline
backend/datasets/real_estate_*_data_final*.csv
backend/datasets/real_estate_*_data_final*.parquet

# Ignore V0 / V1 datasets (generated in raw format, before pre-processing)
backend/datasets/external/*v0*
backend/datasets/external/*v1*

# Keep internal-factor datasets
!backend/datasets/internal/

# Keep external-factor datasets
!backend/datasets/external/

# Ignore JSON datasets inside folder "external" (we will only use CSV or PARQUET)
backend/datasets/external/*.json

# Virtual Environment Package Files
.venv/*

# Python Cache
**/__pycache__/

*.py[cod]

# Environment variables
.env

# VS Code
.vscode/

# JetBrains
.idea/

# Logs
*.log