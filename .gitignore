# ============================================================
# Datasets
# ============================================================

# Ignore all dataset subdirectories by default
backend/datasets/*/

# Generated real-estate datasets
backend/datasets/real_estate_*_data_final*.csv
backend/datasets/real_estate_*_data_final*.parquet

# Data preparation pipeline markers
backend/datasets/internal/.complete*
backend/datasets/external/.complete*

# Ignore V0 / V1 raw datasets
backend/datasets/external/*v0*
backend/datasets/external/*v1*

# Keep dataset directory structure
!backend/datasets/internal/
!backend/datasets/external/

# External datasets: only CSV / Parquet are versioned
backend/datasets/external/*.json


# ============================================================
# Databases
# ============================================================

# DuckDB / local DuckDB files and folders
backend/data/duckdb_source/**


# ============================================================
# Python
# ============================================================

# Virtual environments
.venv/
venv/
env/

# Python cache / compiled files
__pycache__/
**/__pycache__/
*.py[cod]

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/


# ============================================================
# Environment variables / secrets
# ============================================================

.env
.env.*
!.env.example


# ============================================================
# IDE / Editor
# ============================================================

# VS Code
.vscode/

# JetBrains
.idea/

# Local editor files
*.swp
*.swo


# ============================================================
# Logs / temporary files
# ============================================================

*.log
*.tmp
*.temp


# ============================================================
# Test files
# ============================================================
*test*.py

# ============================================================
# OS generated files
# ============================================================

.DS_Store
Thumbs.db